name: Build and Push Docker Image

on:
  push:
    branches:
      - main

  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:      
      - name: Trigger Coolify Deployment
        run: |
          curl -X POST "${{ secrets.COOLIFY_DEPLOY_SERVER_1 }}/api/v1/deploy?uuid=${{ secrets.COOLIFY_PROJECT_ID_WEBPAGE_SYMBIOSIKA_DE }}&force=false" \
          -H "Authorization: Bearer ${{ secrets.COOLIFY_DEPLOY_BEARER_SERVER_1 }}" \
          -H "Content-Type: application/json"