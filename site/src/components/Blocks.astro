---
// Renders a run of content blocks. Consecutive images collapse into a plate
// row and consecutive list items into one list, so that photo sequences and
// enumerations from the original document keep their shape.
import Plate from "./Plate.astro";

const { blocks } = Astro.props;

const runs = [];
for (const block of blocks) {
  const last = runs.at(-1);
  if (block.type === "image" && !block.caption && last?.kind === "images") {
    last.items.push(block);
  } else if (block.type === "image") {
    runs.push({ kind: "images", items: [block] });
  } else if (block.type === "listitem" && last?.kind === "list") {
    last.items.push(block);
  } else if (block.type === "listitem") {
    runs.push({ kind: "list", items: [block] });
  } else {
    runs.push({ kind: "block", block });
  }
}
---

<div class="text">
  {runs.map((run) => {
    if (run.kind === "images") {
      return run.items.length === 1
        ? <Plate file={run.items[0].file} caption={run.items[0].caption} />
        : <div class="plate-row">{run.items.map((i) => <Plate file={i.file} caption={i.caption} compact />)}</div>;
    }
    if (run.kind === "list") {
      return <ul class="entries">{run.items.map((i) => <li>{i.text}</li>)}</ul>;
    }

    const b = run.block;
    switch (b.type) {
      case "verse":
        return <p class="verse">{b.lines.map((line) => <span>{line}</span>)}</p>;
      case "source":
        return <cite class="source">{b.label}: {b.text}</cite>;
      case "heading":
        return b.level >= 4
          ? <h4 class="sub">{b.text}</h4>
          : <h3 class="sub">{b.text}</h3>;
      case "glossary":
        return (
          <dl class="glossary">
            {b.pairs.map((p) => (
              <>
                <dt>{p.term}</dt>
                <dd>{p.form}</dd>
              </>
            ))}
          </dl>
        );
      case "table":
        return (
          <div class="scroll-x">
            <table>
              <thead><tr>{b.head.map((c) => <th scope="col">{c}</th>)}</tr></thead>
              <tbody>
                {b.rows.map((row) => (
                  <tr>{row.map((c) => <td set:html={String(c).replace(/\n/g, "<br>")} />)}</tr>
                ))}
              </tbody>
            </table>
          </div>
        );
      default:
        return <p set:html={String(b.text ?? "").replace(/\n/g, "<br>")} />;
    }
  })}
</div>

<style is:global>
  .entries { margin: 0 0 1.2em; padding-left: 1.1rem; }
  .entries li { margin-bottom: 0.15em; line-height: 1.5; }

  .glossary {
    display: grid;
    grid-template-columns: minmax(6rem, auto) 1fr;
    gap: 0.1rem 1.5rem;
    margin: 0 0 1.4em;
    font-size: 0.98em;
  }
  .glossary dt { font-weight: 600; }
  .glossary dd { margin: 0; font-style: italic; color: var(--ink-soft); }

  h3.sub { font-size: 1.28em; margin: 1.9em 0 0.6em; }
  h4.sub { font-size: 1.05em; margin: 1.5em 0 0.5em; color: var(--ink-soft); }
  .text > h3.sub:first-child, .text > h4.sub:first-child { margin-top: 0; }
</style>
