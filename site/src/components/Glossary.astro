---
// The dialect word list came through the extraction as one word per paragraph,
// with a single capital letter starting each alphabetical group. Rendered as a
// dense column set it reads like the word list it is.
import Blocks from "./Blocks.astro";

const { blocks } = Astro.props;

const groups = [];
const rest = [];
for (const block of blocks) {
  if (block.type === "paragraph" && /^[A-ZÄÖÜ]$/.test(block.text)) {
    groups.push({ letter: block.text, words: [] });
  } else if (groups.length && block.type === "paragraph" && block.text.length <= 60) {
    groups.at(-1).words.push(block.text);
  } else {
    rest.push(block);            // prose that strayed into the word list
  }
}
---

{groups.length > 0 ? (
  <div class="glossary">
    {groups.map((group) => (
      <section>
        <h3>{group.letter}</h3>
        <ul>{group.words.map((w) => <li>{w}</li>)}</ul>
      </section>
    ))}
  </div>
) : null}
{rest.length > 0 && <Blocks blocks={rest} />}

<style>
  .glossary { columns: 3 11rem; column-gap: 2rem; margin-bottom: 1.5rem; }
  .glossary section { break-inside: avoid-column; margin-bottom: 1.2rem; }
  .glossary h3 {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: var(--gold);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.25rem;
    margin-bottom: 0.4rem;
  }
  .glossary ul { list-style: none; margin: 0; padding: 0; font-size: 0.95rem; line-height: 1.45; }
  .glossary li { margin-bottom: 0.1rem; }
  .glossary li { color: var(--ink-soft); }
</style>
