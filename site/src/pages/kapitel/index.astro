---
import Base from "../../layouts/Base.astro";
import { chapters, epochs, stats } from "../../lib/chronik.js";

const sectionCount = chapters.reduce((n, c) => n + c.sections.length, 0);
---

<Base
  title="Kapitel"
  description="Das vollständige Inhaltsverzeichnis der Ortschronik von Strinz-Margarethä, wie es im Buch steht."
>
  <div class="wrap pagehead">
    <p class="eyebrow">Das Buch</p>
    <h1>Kapitel und Inhalt</h1>
    <p class="lede" style="margin-top:1rem">
      Die Ortschronik gliedert sich in {chapters.length + 1} Teile mit
      {sectionCount} Abschnitten. Unten steht ihre vollständige Gliederung, so
      wie das Buch sie selbst führt.
    </p>
  </div>

  <section class="wrap" style="margin:3rem auto">
    <div class="cards">
      <a class="card" href="/chronik/">
        <h3>Chronik nach Jahren</h3>
        <p>{stats.years} überlieferte Jahre von {stats.yearFrom} bis {stats.yearTo}.</p>
        <p class="card__meta">{epochs.length} Zeitalter</p>
      </a>
      {chapters.map((chapter) => (
        <a class="card" href={`/kapitel/${chapter.slug}/`}>
          <h3>{chapter.title}</h3>
          <p class="card__meta">
            {chapter.sections.length} {chapter.sections.length === 1 ? "Abschnitt" : "Abschnitte"}
          </p>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap" style="margin:4rem auto;max-width:52rem">
    <p class="eyebrow">Inhaltsverzeichnis</p>
    <h2 style="font-size:1.9rem;margin:0.4rem 0 1.5rem">Alle Abschnitte</h2>
    <ul class="toc">
      <li>
        <a href="/chronik/">
          <span class="num">7</span>
          <span class="title">Chronik nach Jahren</span>
          <span class="page">{stats.years} Jahre</span>
        </a>
      </li>
      {epochs.map((epoch) => (
        <li>
          <a href={`/chronik/${epoch.slug}/`} class="lvl2">
            <span class="num" />
            <span class="title">{epoch.title}</span>
            <span class="page">{epoch.years.length} Jahre</span>
          </a>
        </li>
      ))}
      {chapters.map((chapter) => (
        <>
          <li>
            <a href={`/kapitel/${chapter.slug}/`}>
              <span class="num">{chapter.number}</span>
              <span class="title">{chapter.title}</span>
              <span class="page" />
            </a>
          </li>
          {chapter.sections.filter((s) => !s.lead).map((section) => (
            <li>
              <a href={`/kapitel/${chapter.slug}/#${section.slug}`} class="lvl2">
                <span class="num" />
                <span class="title">{section.title}</span>
                <span class="page" />
              </a>
            </li>
          ))}
        </>
      ))}
    </ul>
  </section>
</Base>
